{
    "name": "vault-drive",
    "version": "0.1.0",
    "description": "Vault Drive: sync Obsidian vault attachments to Google Drive. Companion to Vault Git.",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs dev",
        "build": "node esbuild.config.mjs production",
        "lint": "eslint src",
        "format": "prettier --check src",
        "tsc": "tsc --noEmit",
        "all": "pnpm run tsc && pnpm run format && pnpm run lint"
    },
    "keywords": [],
    "author": "Vault Drive contributors",
    "license": "MIT",
    "engines": {
        "node": ">=18",
        "pnpm": ">=9"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@types/node": "^22.19.10",
        "@typescript-eslint/parser": "8.47.0",
        "esbuild": "^0.24.2",
        "eslint": "^9.39.2",
        "obsidian": "^1.11.4",
        "prettier": "3.3.2",
        "tslib": "^2.8.1",
        "typescript": "5.8.3",
        "typescript-eslint": "^8.54.0"
    }
}
